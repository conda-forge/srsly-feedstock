From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pavel Zwerschke <pavelzw@gmail.com>
Date: Wed, 25 Nov 2026 15:51:26 +0100
Subject: [PATCH] msgpack: Restore srsly 2.x registry API for encoders/decoders

The "Unvendor msgpack" patch replaced the catalogue registries
`srsly.msgpack_encoders` / `srsly.msgpack_decoders` with the minimal
`_MsgpackExtensions` class from srsly 3.0. That is a breaking API change
within 2.x: the registries can no longer be used as decorators
(`@srsly.msgpack_encoders("name")`), have no `get`/`get_all`, don't load
entry points, and call extensions without the `chain` argument.

This breaks e.g. spacy-curated-transformers on import:

    TypeError: '_MsgpackEncoderExtensions' object is not callable

Restore the 2.x API on top of upstream msgpack: use catalogue registries
again and chain the registered functions via `chain=` like the vendored
msgpack's Packer/Unpacker did. The complex and subtype handling needed
for `strict_types=True` runs as the innermost fallback.
---
 srsly/_msgpack_api.py           | 115 +++++++++++++-------------------
 srsly/_msgpack_numpy.py         |  10 +--
 srsly/tests/test_msgpack_api.py |  30 +++++++++
 3 files changed, 82 insertions(+), 73 deletions(-)

diff --git a/srsly/_msgpack_api.py b/srsly/_msgpack_api.py
index 3f621be..10b4b41 100644
--- a/srsly/_msgpack_api.py
+++ b/srsly/_msgpack_api.py
@@ -1,93 +1,72 @@
+import functools
 import gc
 from contextlib import contextmanager
 
+import catalogue
 import msgpack
 
 from .util import force_path, FilePath, JSONInputBin, JSONOutputBin
 from ._msgpack_numpy import encode_numpy, decode_numpy
 
 
-class _MsgpackExtensions:
-    """API for extending msgpack (de)serialization:
+# Keep the srsly 2.x extension API: catalogue registries (usable as decorators,
+# e.g. ``@srsly.msgpack_encoders("name")``, and discoverable via entry points)
+# whose functions take ``(obj, chain=None)`` and pass unhandled objects on to
+# ``chain``. The registry-less API is only introduced in srsly 3.0.
+msgpack_encoders = catalogue.create("srsly", "msgpack_encoders", entry_points=True)
+msgpack_decoders = catalogue.create("srsly", "msgpack_decoders", entry_points=True)
 
-        srsly.msgpack_encoders.register(name, func)
-        srsly.msgpack_decoders.register(name, func)
 
-    where `name` is a unique ID and `func` is a callable that accepts a single
-    argument:
-
-    - For encoders, the argument is the object to serialize. The callable should
-      return a new object (typically a dict) or the original object if the callback
-      does not recognize it.
-    - For decoders, the argument is the dict to deserialize, as returned by the encoders.
-      The callable should return a new object or the original dict if the callback
-      does not recognize it.
-    """
-
-    __slots__ = ("_ext",)
-
-    def __init__(self):
-        self._ext = {}
-
-    def register(self, name, func):
-        """Register a custom encoder/decoder function"""
-        self._ext[name] = func
-
-    def deregister(self, name):
-        del self._ext[name]
-
-    def _run(self, obj):
-        for func in self._ext.values():
-            out = func(obj)
-            if out is not obj:
-                return out
-        return obj
+def encode_complex(obj):
+    if isinstance(obj, complex):
+        return {b"complex": True, b"data": repr(obj)}
+    return obj
 
 
-class _MsgpackEncoderExtensions(_MsgpackExtensions):
-    def _run(self, obj):
-        out = super()._run(obj)
-        if out is not obj:
-            return out
+def decode_complex(obj):
+    if b"complex" in obj:
+        return complex(obj[b"data"])
+    return obj
 
-        # Convert subtypes of base types and tuples to lists.
-        # Effectively this undoes the strict_types=True option of msgpack.
-        # This is needed to support np.float64, which is a subclass of builtin float.
-        # Run this last to allow the user to register their own handlers first.
 
-        if isinstance(obj, tuple):
-            return list(obj)
-        # Note: bool and memoryview can't be subclassed
-        # set and frozenset are not supported by msgpack
-        for cls in (int, float, list, dict, str, bytes):
-            if isinstance(obj, cls):
-                return cls(obj)
+def _encode_fallback(obj):
+    # Runs after all registered encoders, so np.complex128 (a subclass of the
+    # built-in complex) is handled by encode_numpy first.
+    out = encode_complex(obj)
+    if out is not obj:
+        return out
+
+    # Convert subtypes of base types and tuples to lists.
+    # Effectively this undoes the strict_types=True option of msgpack.
+    # This is needed to support np.float64, which is a subclass of builtin float.
+    if isinstance(obj, tuple):
+        return list(obj)
+    # Note: bool and memoryview can't be subclassed
+    # set and frozenset are not supported by msgpack
+    for cls in (int, float, list, dict, str, bytes):
+        if isinstance(obj, cls):
+            return cls(obj)
 
-        return obj
+    return obj
 
 
-msgpack_encoders = _MsgpackEncoderExtensions()
-msgpack_decoders = _MsgpackExtensions()
+def _chain(registry, fallback):
+    hook = fallback
+    for func in registry.get_all().values():
+        hook = functools.partial(func, chain=hook)
+    return hook
 
 
-def encode_complex(obj):
-    if isinstance(obj, complex):
-        return {b"complex": True, b"data": repr(obj)}
-    return obj
+def _default():
+    return _chain(msgpack_encoders, _encode_fallback)
 
 
-def decode_complex(obj):
-    if b"complex" in obj:
-        return complex(obj[b"data"])
-    return obj
+def _object_hook():
+    return _chain(msgpack_decoders, decode_complex)
 
 
 msgpack_encoders.register("numpy", func=encode_numpy)
 msgpack_decoders.register("numpy", func=decode_numpy)
-# Note: np.complex128 is a subclass of built-in complex, so
-# encode_complex must be registered after encode_numpy.
-msgpack_encoders.register("complex", func=encode_complex)
-msgpack_decoders.register("complex", func=decode_complex)
 
 
 @contextmanager
@@ -111,7 +90,7 @@ def msgpack_dumps(data: JSONInputBin) -> bytes:
         # strict_types is False for everything except np.float64
         # and np.complex128 (see above)
         strict_types=True,
-        default=msgpack_encoders._run,
+        default=_default(),
     )
 
 
@@ -125,7 +104,7 @@ def msgpack_loads(data: bytes, use_list: bool = True) -> JSONOutputBin:
     """
     with _without_gc():
         return msgpack.loads(
-            data, raw=False, use_list=use_list, object_hook=msgpack_decoders._run, strict_map_key=False
+            data, raw=False, use_list=use_list, object_hook=_object_hook(), strict_map_key=False
         )
 
 
@@ -137,7 +116,7 @@ def write_msgpack(path: FilePath, data: JSONInputBin) -> None:
     """
     file_path = force_path(path, require_exists=False)
     with file_path.open("wb") as f:
-        msgpack.dump(data, f, strict_types=True, default=msgpack_encoders._run)
+        msgpack.dump(data, f, strict_types=True, default=_default())
 
 
 def read_msgpack(path: FilePath, use_list: bool = True) -> JSONOutputBin:
@@ -151,5 +130,5 @@ def read_msgpack(path: FilePath, use_list: bool = True) -> JSONOutputBin:
     file_path = force_path(path)
     with file_path.open("rb") as f, _without_gc():
         return msgpack.load(
-            f, raw=False, use_list=use_list, object_hook=msgpack_decoders._run, strict_map_key=False
+            f, raw=False, use_list=use_list, object_hook=_object_hook(), strict_map_key=False
         )
diff --git a/srsly/_msgpack_numpy.py b/srsly/_msgpack_numpy.py
index a3a842c..4202316 100644
--- a/srsly/_msgpack_numpy.py
+++ b/srsly/_msgpack_numpy.py
@@ -22,12 +22,12 @@ except ImportError:
     has_cupy = False
 
 
-def encode_numpy(obj):
+def encode_numpy(obj, chain=None):
     """
     Data encoder for serializing numpy data types.
     """
     if not has_numpy:
-        return obj
+        return obj if chain is None else chain(obj)
     if has_cupy and isinstance(obj, cupy.ndarray):
         obj = obj.get()
     if isinstance(obj, np.ndarray):
@@ -49,15 +49,15 @@ def encode_numpy(obj):
     if isinstance(obj, (np.bool_, np.number)):
         return {b"nd": False, b"type": obj.dtype.str, b"data": obj.data}
 
-    return obj
+    return obj if chain is None else chain(obj)
 
 
-def decode_numpy(obj):
+def decode_numpy(obj, chain=None):
     """
     Decoder for deserializing numpy data types.
     """
     if b"nd" not in obj:
-        return obj
+        return obj if chain is None else chain(obj)
 
     # Crash with a clean ModuleNotFoundError if numpy is not available
     # instead of AttributeError
diff --git a/srsly/tests/test_msgpack_api.py b/srsly/tests/test_msgpack_api.py
index dab3d20..dd0680e 100644
--- a/srsly/tests/test_msgpack_api.py
+++ b/srsly/tests/test_msgpack_api.py
@@ -96,3 +96,33 @@ def test_msgpack_custom_encoder_decoder():
     assert isinstance(new_data["a"], numpy.ndarray)
     assert isinstance(new_data["b"], CustomObject)
     assert new_data["b"].value == {"foo": "bar"}
+
+
+def test_msgpack_registry_decorator():
+    """srsly 2.x API: the registries are catalogue registries that can be used
+    as decorators (used e.g. by spacy-curated-transformers)."""
+
+    class DecoratedObject:
+        def __init__(self, value):
+            self.value = value
+
+    @msgpack_encoders("decorated_object")
+    def serialize_obj(obj, chain=None):
+        if isinstance(obj, DecoratedObject):
+            return {"__decorated__": obj.value}
+        return obj if chain is None else chain(obj)
+
+    @msgpack_decoders("decorated_object")
+    def deserialize_obj(obj, chain=None):
+        if "__decorated__" in obj:
+            return DecoratedObject(obj["__decorated__"])
+        return obj if chain is None else chain(obj)
+
+    assert "decorated_object" in msgpack_encoders.get_all()
+    assert "decorated_object" in msgpack_decoders.get_all()
+    data = {"a": DecoratedObject(1), "b": numpy.zeros((2,)), "c": 1 + 2j}
+    result = msgpack_loads(msgpack_dumps(data))
+    assert isinstance(result["a"], DecoratedObject)
+    assert result["a"].value == 1
+    assert isinstance(result["b"], numpy.ndarray)
+    assert result["c"] == 1 + 2j
-- 
